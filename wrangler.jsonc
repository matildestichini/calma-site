// Publicação na Cloudflare (Worker "calmahomespa", só ficheiros estáticos).
{
  "name": "calmahomespa",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "."
  },
  "routes": [
    { "pattern": "calmahomespa.co.mz", "custom_domain": true },
    { "pattern": "www.calmahomespa.co.mz", "custom_domain": true }
  ]
}
